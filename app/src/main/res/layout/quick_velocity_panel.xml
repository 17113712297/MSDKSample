<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickVelocityPanel"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:layout_marginStart="12dp"
    android:layout_marginTop="100dp"
    android:layout_marginBottom="64dp"
    android:background="@drawable/bg_dashboard_panel"
    android:clickable="true"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="手动速度控制"
            android:textColor="#F0F6FF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/quickVelocityTargets"
            style="@style/DashboardHint"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="X +0.0  Y +0.0  Z +0.0 m/s\n偏航 +0.0 °/s"
            android:textColor="#D5E3F4"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/velocityWorkspaceHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
