<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- FPV 实时画面，全屏铺底 -->
    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 变焦滑块，右侧居中 -->
    <dji.v5.ux.visualcamera.zoom.FocalZoomWidget
        android:id="@+id/focalZoomWidget"
        android:layout_width="40dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- 镜头切换按钮组，右侧变焦滑块上方 -->
    <LinearLayout
        android:id="@+id/lensControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#AA000000"
        android:padding="4dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="64dp">

        <Button
            android:id="@+id/btnLensWide"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:text="广角"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnLensZoom"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:text="变焦"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnLensThermal"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:text="红外"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- 拍照/录像模式切换 -->
    <dji.v5.ux.cameracore.widget.cameracontrols.photovideoswitch.PhotoVideoSwitchWidget
        android:id="@+id/photoVideoSwitchWidget"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="144dp" />

    <!-- 录像按钮 -->
    <dji.v5.ux.cameracore.widget.cameracapture.recordvideo.RecordVideoWidget
        android:id="@+id/recordVideoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp" />

    <!-- 拍照按钮 -->
    <dji.v5.ux.cameracore.widget.cameracapture.shootphoto.ShootPhotoWidget
        android:id="@+id/shootPhotoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>

