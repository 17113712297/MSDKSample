<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#09111D" tools:context=".MainActivity">

    <dji.v5.ux.core.widget.fpv.FPVWidget android:id="@+id/fpvWidget"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <include layout="@layout/quick_collection_panel" />
    <include layout="@layout/quick_velocity_panel" />

    <View android:id="@+id/menuScrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#55000000" android:visibility="gone" android:clickable="true"
        android:contentDescription="收起功能菜单" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/menuDrawer" android:layout_width="364dp" android:layout_height="match_parent"
        android:layout_gravity="end" android:layout_marginTop="100dp" android:layout_marginEnd="12dp"
        android:layout_marginBottom="64dp" android:background="@drawable/bg_dashboard_panel"
        android:orientation="vertical" android:padding="14dp" android:visibility="gone"
        android:clickable="true" android:focusable="true" android:elevation="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="功能菜单" android:textSize="18sp" android:textColor="#F0F6FF" android:fontFamily="sans-serif-medium" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenuClose" style="@style/DashboardButton"
                android:layout_width="44dp" android:layout_height="40dp" android:layout_marginTop="0dp"
                android:text="关闭" android:textSize="11sp" android:contentDescription="关闭功能菜单" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenuFlight" style="@style/DashboardButton.Tab" android:text="飞行" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenuMission" style="@style/DashboardButton.Tab" android:text="作业" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenuCamera" style="@style/DashboardButton.Tab" android:text="相机" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenuTools" style="@style/DashboardButton.Tab" android:text="工具" />
        </LinearLayout>
        <ScrollView android:id="@+id/menuScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <include layout="@layout/menu_flight_panel" />
                <include layout="@layout/menu_mission_panel" />
                <include layout="@layout/menu_camera_panel" />
                <include layout="@layout/menu_tools_panel" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/topBarLayout" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_gravity="top" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="12dp" android:background="#F0101C2A">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="14dp"
            android:text="飞行控制" android:textSize="14sp" android:textColor="#F4F8FF" android:fontFamily="sans-serif-medium" />
        <dji.v5.ux.core.widget.systemstatus.SystemStatusWidget android:id="@+id/systemStatusWidget"
            android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" />
        <dji.v5.ux.core.widget.flightmode.FlightModeWidget android:id="@+id/flightModeWidget"
            android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" />
        <dji.v5.ux.core.widget.gpssignal.GpsSignalWidget android:id="@+id/gpsSignalWidget"
            android:layout_width="32dp" android:layout_height="30dp" android:layout_marginStart="8dp" />
        <dji.v5.ux.core.widget.remotecontrollersignal.RemoteControllerSignalWidget android:id="@+id/rcSignalWidget"
            android:layout_width="32dp" android:layout_height="30dp" android:layout_marginStart="4dp" />
        <dji.v5.ux.core.widget.videosignal.VideoSignalWidget android:id="@+id/videoSignalWidget"
            android:layout_width="32dp" android:layout_height="30dp" android:layout_marginStart="4dp" />
        <dji.v5.ux.core.widget.battery.BatteryWidget android:id="@+id/batteryWidget"
            android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMenu" style="@style/DashboardButton"
            android:layout_width="84dp" android:layout_height="40dp" android:layout_marginTop="0dp" android:layout_marginStart="12dp"
            android:text="☰ 菜单" android:contentDescription="打开功能菜单" />
    </LinearLayout>

    <LinearLayout android:id="@+id/hudLayout" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_gravity="top" android:layout_marginTop="56dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:background="@drawable/bg_dashboard_panel" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView style="@style/DashboardMetricLabel" android:text="X" />
        <TextView android:id="@+id/xSpeedText" style="@style/DashboardMetricValue" android:text="--" />
        <TextView style="@style/DashboardMetricLabel" android:text="Y" />
        <TextView android:id="@+id/ySpeedText" style="@style/DashboardMetricValue" android:text="--" />
        <TextView style="@style/DashboardMetricLabel" android:text="Z" />
        <TextView android:id="@+id/zSpeedText" style="@style/DashboardMetricValue" android:text="--" />
        <TextView style="@style/DashboardMetricLabel" android:text="偏航" />
        <TextView android:id="@+id/yawRateText" style="@style/DashboardMetricValue" android:text="--" />
        <TextView style="@style/DashboardMetricLabel" android:text="剩余" />
        <TextView android:id="@+id/remainingTimeText" style="@style/DashboardMetricValue" android:text="--:--" />
        <TextView android:id="@+id/motorTemperatureText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="电机温度：状态未知" android:textSize="12sp"
            android:textColor="#DAB979" android:maxLines="1" android:fontFamily="sans-serif-medium"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>

    <LinearLayout android:id="@+id/taskStatusBar" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dashboard_panel" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/taskStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="等待操作" android:textSize="12sp" android:textColor="#D5E3F4" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/missionStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="任务：等待状态上报" android:textSize="10sp" android:textColor="#91A4BA"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnQuickPause" style="@style/DashboardButton"
            android:layout_width="84dp" android:layout_height="40dp" android:layout_marginTop="0dp" android:layout_marginStart="6dp"
            android:text="暂停任务" android:textSize="11sp" android:textColor="#F4CE7C" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnQuickAbortLanding" style="@style/DashboardButton"
            android:layout_width="88dp" android:layout_height="40dp" android:layout_marginTop="0dp" android:layout_marginStart="6dp"
            android:text="中止降落" android:textSize="11sp" android:textColor="#FF949D" android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnQuickStopVelocity" style="@style/DashboardButton"
            android:layout_width="110dp" android:layout_height="40dp" android:layout_marginTop="0dp" android:layout_marginStart="6dp"
            android:text="停止速度控制" android:textSize="11sp" android:textColor="#F4CE7C" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
