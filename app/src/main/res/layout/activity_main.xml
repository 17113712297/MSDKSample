<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- FPV 实时画面，全屏铺底 -->
    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══════════════ 顶部状态栏 ══════════════ -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="#BB000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <dji.v5.ux.core.widget.systemstatus.SystemStatusWidget
            android:id="@+id/systemStatusWidget"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1" />

        <dji.v5.ux.core.widget.flightmode.FlightModeWidget
            android:id="@+id/flightModeWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.gpssignal.GpsSignalWidget
            android:id="@+id/gpsSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.remotecontrollersignal.RemoteControllerSignalWidget
            android:id="@+id/rcSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.videosignal.VideoSignalWidget
            android:id="@+id/videoSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.battery.BatteryWidget
            android:id="@+id/batteryWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />
        <Button
            android:id="@+id/btnPsdkTest"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:text="PSDK"
            android:textSize="10sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />



    </LinearLayout>

    <!-- ══════════════ 左侧飞行数据 HUD ══════════════ -->
    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:background="#BB000000"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- X 轴速度（北向） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="X轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/xSpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <!-- Y 轴速度（东向） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Y轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/ySpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <!-- Z 轴速度（垂直，正=上升） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Z轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/zSpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <!-- 偏航速度（°/s，差分计算） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="偏航速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/yawRateText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="-- °/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <!-- 剩余时间（飞行中才有值） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="剩余时间"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/remainingTimeText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════ 变焦滑块（镜头按钮左边）══════════════ -->
    <dji.v5.ux.visualcamera.zoom.FocalZoomWidget
        android:id="@+id/focalZoomWidget"
        android:layout_width="40dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="80dp"
        android:visibility="gone" />

    <!-- ══════════════ 镜头切换按钮组（最右侧）══════════════ -->
    <LinearLayout
        android:id="@+id/lensControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="16dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnLensWide"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="广角"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensZoom"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="变焦"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensThermal"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="红外"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- ══════════════ 右下角拍照录像控件 ══════════════ -->
    <dji.v5.ux.cameracore.widget.cameracontrols.photovideoswitch.PhotoVideoSwitchWidget
        android:id="@+id/photoVideoSwitchWidget"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="144dp" />

    <dji.v5.ux.cameracore.widget.cameracapture.recordvideo.RecordVideoWidget
        android:id="@+id/recordVideoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp" />

    <dji.v5.ux.cameracore.widget.cameracapture.shootphoto.ShootPhotoWidget
        android:id="@+id/shootPhotoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>

