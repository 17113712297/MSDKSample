<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="#BB000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <dji.v5.ux.core.widget.systemstatus.SystemStatusWidget
            android:id="@+id/systemStatusWidget"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1" />

        <dji.v5.ux.core.widget.flightmode.FlightModeWidget
            android:id="@+id/flightModeWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.gpssignal.GpsSignalWidget
            android:id="@+id/gpsSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.remotecontrollersignal.RemoteControllerSignalWidget
            android:id="@+id/rcSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.videosignal.VideoSignalWidget
            android:id="@+id/videoSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.battery.BatteryWidget
            android:id="@+id/batteryWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

<!-- ★ 模式切换按钮条 -->
    <LinearLayout
        android:id="@+id/modeSelectorLayout"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/topBarLayout"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnModeMapping"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#455A64"
            android:padding="0dp"
            android:text="建图模式"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeCollect"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#455A64"
            android:padding="0dp"
            android:text="采点模式"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeCruise"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:backgroundTint="#455A64"
            android:padding="0dp"
            android:text="巡航模式"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 底部居中 HUD 信息栏 (水平排列)                          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="X:" android:textColor="#AAFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/xSpeedText" android:layout_width="68dp"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="Y:" android:textColor="#AAFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/ySpeedText" android:layout_width="68dp"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="Z:" android:textColor="#AAFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/zSpeedText" android:layout_width="68dp"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Yaw:" android:textColor="#AAFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/yawRateText" android:layout_width="60dp"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="剩余:" android:textColor="#AAFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/remainingTimeText" android:layout_width="56dp"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:gravity="end" android:text="--:--" android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 直播按钮 (右上角，镜头控制左边)                         -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/transferDebugText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/hudLayout"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#CC102027"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:text="传输调试信息"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnLiveStreamPanel"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="60dp"
        android:layout_toStartOf="@id/lensControlLayout"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#455A64"
        android:padding="0dp"
        android:text="直播"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/lensControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnLensWide"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="广角"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensZoom"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="变焦"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensThermal"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="红外"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveStreamLayout"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/liveStreamAddressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RTMP 地址"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/liveStreamAddressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/liveStreamAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1AFFFFFF"
            android:fontFamily="monospace"
            android:hint="rtmp://192.168.1.20:1935/live/obs1"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLiveStreamSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1565C0"
            android:text="保存推流地址"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/liveStreamStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="状态"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/liveStreamStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="未开始"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLiveStreamAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2E7D32"
            android:text="开始 RTMP 推流"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 右侧中部：起飞检查/视觉降落 + 航点控制 (水平并排)       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/rightControlContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/lensControlLayout"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:orientation="horizontal">

        <!-- 起飞前检查 + 视觉降落 (竖排，在航点左边) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="4dp">

            <Button
                android:id="@+id/btnTakeoff"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:backgroundTint="#1976D2"
                android:padding="0dp"
                android:text="起飞前检查"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAutoLanding"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#D32F2F"
                android:padding="0dp"
                android:text="视觉降落"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 航点控制 (竖排) -->
        <LinearLayout
            android:id="@+id/waypointControlLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="4dp">

            <Button
                android:id="@+id/btnRecordWaypoint"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:backgroundTint="#555555"
                android:padding="0dp"
                android:text="记录航点"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSaveWaypoints"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#555555"
                android:padding="0dp"
                android:text="保存航线"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClearWaypoints"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#555555"
                android:padding="0dp"
                android:text="清除航点"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- 速度控制面板 — 左下角，HUD 上方                          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/velocityControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/hudLayout"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="5dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtVelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="速度控制"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:paddingBottom="3dp" />

        <Button
            android:id="@+id/btnVelStartStop"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="启动"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnVelZero"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="速度归零"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="3dp"
            android:background="#44FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnVelYawMinus" android:layout_width="44dp" android:layout_height="44dp"
                android:backgroundTint="#9C27B0" android:padding="0dp" android:text="Yaw-"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <Button android:id="@+id/btnVelYawPlus" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="3dp" android:backgroundTint="#9C27B0" android:padding="0dp"
                android:text="Yaw+" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnVelXMinus" android:layout_width="44dp" android:layout_height="44dp"
                android:backgroundTint="#1976D2" android:padding="0dp" android:text="X-"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <Button android:id="@+id/btnVelXPlus" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="3dp" android:backgroundTint="#1976D2" android:padding="0dp"
                android:text="X+" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnVelYMinus" android:layout_width="44dp" android:layout_height="44dp"
                android:backgroundTint="#388E3C" android:padding="0dp" android:text="Y-"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <Button android:id="@+id/btnVelYPlus" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="3dp" android:backgroundTint="#388E3C" android:padding="0dp"
                android:text="Y+" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnVelZMinus" android:layout_width="44dp" android:layout_height="44dp"
                android:backgroundTint="#F57C00" android:padding="0dp" android:text="Z-"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <Button android:id="@+id/btnVelZPlus" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="3dp" android:backgroundTint="#F57C00" android:padding="0dp"
                android:text="Z+" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="等待N挡..."
            android:textColor="#88FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <dji.v5.ux.visualcamera.zoom.FocalZoomWidget
        android:id="@+id/focalZoomWidget"
        android:layout_width="40dp"
        android:layout_height="200dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="24dp"
        android:layout_toStartOf="@id/lensControlLayout"
        android:visibility="gone" />

    <dji.v5.ux.cameracore.widget.cameracapture.shootphoto.ShootPhotoWidget
        android:id="@+id/shootPhotoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp" />

    <dji.v5.ux.cameracore.widget.cameracapture.recordvideo.RecordVideoWidget
        android:id="@+id/recordVideoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_above="@id/shootPhotoWidget"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

    <dji.v5.ux.cameracore.widget.cameracontrols.photovideoswitch.PhotoVideoSwitchWidget
        android:id="@+id/photoVideoSwitchWidget"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_above="@id/recordVideoWidget"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>
