<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <dji.v5.ux.core.widget.fpv.FPVWidget
        android:id="@+id/fpvWidget"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="#BB000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <dji.v5.ux.core.widget.systemstatus.SystemStatusWidget
            android:id="@+id/systemStatusWidget"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1" />

        <dji.v5.ux.core.widget.flightmode.FlightModeWidget
            android:id="@+id/flightModeWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.gpssignal.GpsSignalWidget
            android:id="@+id/gpsSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

        <dji.v5.ux.core.widget.remotecontrollersignal.RemoteControllerSignalWidget
            android:id="@+id/rcSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.videosignal.VideoSignalWidget
            android:id="@+id/videoSignalWidget"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp" />

        <dji.v5.ux.core.widget.battery.BatteryWidget
            android:id="@+id/batteryWidget"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:background="#BB000000"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="X轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/xSpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Y轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ySpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Z轴速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zSpeedText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="-- m/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="偏航速度"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/yawRateText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="-- °/s"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="剩余时间"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/remainingTimeText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAutoLanding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#D32F2F"
            android:text="视觉降落"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTakeoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#1976D2"
            android:text="起飞前检查"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lensControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnLensWide"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="广角"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensZoom"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="变焦"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnLensThermal"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="红外"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/waypointControlLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/lensControlLayout"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="4dp">

        <Button
            android:id="@+id/btnRecordWaypoint"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="记录航点"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSaveWaypoints"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="保存航线"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnClearWaypoints"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#555555"
            android:padding="0dp"
            android:text="清除航点"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <dji.v5.ux.visualcamera.zoom.FocalZoomWidget
        android:id="@+id/focalZoomWidget"
        android:layout_width="40dp"
        android:layout_height="200dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="24dp"
        android:layout_toStartOf="@id/lensControlLayout"
        android:visibility="gone" />

    <dji.v5.ux.cameracore.widget.cameracapture.shootphoto.ShootPhotoWidget
        android:id="@+id/shootPhotoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp" />

    <dji.v5.ux.cameracore.widget.cameracapture.recordvideo.RecordVideoWidget
        android:id="@+id/recordVideoWidget"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_above="@id/shootPhotoWidget"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

    <dji.v5.ux.cameracore.widget.cameracontrols.photovideoswitch.PhotoVideoSwitchWidget
        android:id="@+id/photoVideoSwitchWidget"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_above="@id/recordVideoWidget"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>